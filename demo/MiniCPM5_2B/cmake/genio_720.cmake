# 工具链的真实位置通过本地环境传入,不固化主机地址或内部路径.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{MINICPM5_CXX} OR "$ENV{MINICPM5_CXX}" STREQUAL "")
    message(FATAL_ERROR "请从本地平台配置设置 MINICPM5_CXX,指向 AArch64 C++ 编译器")
endif()
if(NOT DEFINED ENV{MINICPM5_SYSROOT} OR "$ENV{MINICPM5_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR "请从本地平台配置设置 MINICPM5_SYSROOT")
endif()
set(CMAKE_CXX_COMPILER "$ENV{MINICPM5_CXX}")
set(CMAKE_SYSROOT "$ENV{MINICPM5_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
if(DEFINED ENV{MINICPM5_TARGET_DEPS} AND NOT "$ENV{MINICPM5_TARGET_DEPS}" STREQUAL "")
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{MINICPM5_TARGET_DEPS}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
