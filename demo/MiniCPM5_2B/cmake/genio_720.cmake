# try_compile 也读取同一个 JSON,本文件只包含平台逻辑,无需用户填写路径.
set(config_file "${CMAKE_CURRENT_LIST_DIR}/../config.json")
if(NOT EXISTS "${config_file}")
    message(FATAL_ERROR "请复制 config.example.json 为 config.json 并填写配置")
endif()
file(READ "${config_file}" demo_config)
string(JSON CMAKE_CXX_COMPILER GET "${demo_config}" cxx)
string(JSON CMAKE_SYSROOT GET "${demo_config}" sysroot)
string(JSON NEURON_INCLUDE_DIR GET "${demo_config}" sdk_include)
string(JSON DEMO_DEPENDENCIES GET "${demo_config}" dependencies)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

foreach(required CMAKE_CXX_COMPILER CMAKE_SYSROOT NEURON_INCLUDE_DIR DEMO_DEPENDENCIES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "config.json 缺少 ${required}")
    endif()
    if(NOT IS_ABSOLUTE "${${required}}" OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "config.json 中 ${required} 必须是已存在的绝对路径")
    endif()
endforeach()
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${DEMO_DEPENDENCIES}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
